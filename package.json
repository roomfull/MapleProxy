{
  "name": "mapleproxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "vendor/siwc"
  ],
  "scripts": {
    "build:vendor": "npm run build -w @siwc/local",
    "test": "npm run build:vendor && vitest run && node --test vendor/siwc/test/*.test.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck -w @siwc/local",
    "build": "npm run build:vendor && tsc -p tsconfig.build.json && node scripts/build-assets.mjs",
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/src/server/main.js",
    "setup": "tsx scripts/setup.ts",
    "notices:generate": "node scripts/runtime-notices.mjs"
  },
  "dependencies": {
    "@siwc/local": "file:vendor/siwc"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.8.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
